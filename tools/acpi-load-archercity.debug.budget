# Window W1 of the ACPI specification (§7.4) on a recorded machine: the load of the definition blocks of Intel's
# ArcherCity, a server, inside the ring-0 corpus test the_boot_module_machine_loads, on a debug server kernel
# (./build.sh --server). The boot runs the same function on q35's own tables first, hence skip=1. tools/acpi-corpus.sh
# module 'Server/Intel/ArcherCity/ArcherCity/356135E81941' writes the module. Checked by tools/instructions.sh
# --budget tools/acpi-load-archercity.debug.budget kernel/lpl.kernel; a change that moves the count records the new
# one.
inside=advanced_configuration_and_power_interface_machine_language_load_directory
skip=1
times=1
machine=q35
append=lpl.test=advanced_configuration_and_power_interface_corpus.the_boot_module_machine_loads
module=build/acpi-corpus/modules/Server_Intel_ArcherCity_ArcherCity_356135E81941.acpi
instructions=279533270
accesses=139702614
tolerance=1
