# Window W1 of the ACPI specification (§7.4) on the release path, on QEMU's own q35 tables given as a module: the load
# of the definition blocks of q35, as a release kernel loads them (O2), inside the ring-0 corpus test
# the_boot_module_machine_loads_on_the_release_path, on a debug server kernel (./build.sh --server). The boot runs the
# same function on the tables it reads from the machine first, hence skip=1. tools/acpi-corpus.sh module qemu q35
# kernel/lpl.kernel writes the module. It measures the gap of the other W1 windows on the release path to a release
# kernel, on the same tables: this window counts 3,642 instructions (2.15 %) fewer than a release kernel's 169,552
# (tools/instructions.sh --budget tools/acpi-load.budget), all of them in mapping the firmware's windows, which the
# simulated host does without the kernel's page tables. Checked by tools/instructions.sh --budget
# tools/acpi-load-q35.release-path.debug.budget kernel/lpl.kernel; a change that moves the count records the new one.
inside=advanced_configuration_and_power_interface_machine_language_load_directory
skip=1
times=1
machine=q35
append=lpl.test=advanced_configuration_and_power_interface_corpus.the_boot_module_machine_loads_on_the_release_path
module=build/acpi-corpus/modules/q35.acpi
instructions=165910
accesses=93223
tolerance=1
