# Window W4 of the ACPI specification (§7.4): the test the_window_w4_loop_of_a_thousand_turns, which loads a table
# whose method runs `While (LLess (Local0, 0x03E8)) { Increment (Local0) }`, evaluates it under a revision-2 DSDT, then
# under a revision-1 DSDT, then loads and evaluates a polling loop of 1,000 turns; on a debug server kernel
# (./build.sh --server), the test alone selected so that no other test changes the page allocator it starts from.
# Checked by tools/instructions.sh --budget tools/acpi-microbenchmark.debug.budget kernel/lpl.kernel; a change that
# moves the interpreter's loop records the new counts. The first evaluations count together with the same command
# and --inside advanced_configuration_and_power_interface_machine_language_evaluate --times 1, 2 then 3: 1,143,419,
# 2,293,848 and 7,521,787 instructions, so 1,143.4 per turn of the loop under revision 2 against the 200 of §7.4 (#584);
# the difference of the last two, 5,227.9 per turn, is the cost of the polling loop. A fourth evaluation breaks the
# polling loop at its first turn.
inside=kernel_test_body_the_window_w4_loop_of_a_thousand_turns
times=1
append=lpl.test=advanced_configuration_and_power_interface_microbenchmarks.the_window_w4_loop_of_a_thousand_turns
instructions=10190774
accesses=4865166
tolerance=1
