# Window W2 of the ACPI specification (§7.4) on a recorded machine: the initialisation of the namespace of Intel's
# ArcherCity, a server, steps 2 to 9 of §3.8, inside the ring-0 corpus test the_boot_module_machine_loads, on a debug
# server kernel (./build.sh --server). The boot runs the same function on q35's own tables first, hence skip=1.
# tools/acpi-corpus.sh module 'Server/Intel/ArcherCity/ArcherCity/356135E81941' writes the module. Checked by
# tools/instructions.sh --budget tools/acpi-initialization-archercity.debug.budget kernel/lpl.kernel; a change that
# moves the count records the new one.
inside=advanced_configuration_and_power_interface_initialize_namespace
skip=1
times=1
machine=q35
append=lpl.test=advanced_configuration_and_power_interface_corpus.the_boot_module_machine_loads
module=build/acpi-corpus/modules/Server_Intel_ArcherCity_ArcherCity_356135E81941.acpi
instructions=62451478
accesses=29895704
tolerance=1
