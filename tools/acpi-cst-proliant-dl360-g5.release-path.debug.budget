# Window W3 of the ACPI specification (§7.4) on a recorded machine, on the release path: step 8 of §3.8, the evaluation
# of the _CST objects of the HP ProLiant DL360 G5, a server whose eight processors publish their _CST, once loaded as a
# release kernel loads it (O2), inside the ring-0 corpus test the_boot_module_machine_loads_on_the_release_path, on a
# debug server kernel (./build.sh --server). The boot runs the same function on q35's own tables first, hence skip=1.
# tools/acpi-corpus.sh module 'Server/Hewlett-Packard/ProLiant/ProLiant DL360 G5/A8DA802364DF' writes the module. The
# gap of an evaluation to a release kernel is not measured: q35's processors hold no _CST, and the walk to them alone
# counts the same as a release kernel's (tools/acpi-cst-q35.release-path.debug.budget). Checked by tools/instructions.sh
# --budget tools/acpi-cst-proliant-dl360-g5.release-path.debug.budget kernel/lpl.kernel; a change that moves the count
# records the new one.
inside=advanced_configuration_and_power_interface_processor_idle_publish
skip=1
times=1
machine=q35
append=lpl.test=advanced_configuration_and_power_interface_corpus.the_boot_module_machine_loads_on_the_release_path
module=build/acpi-corpus/modules/Server_Hewlett-Packard_ProLiant_ProLiant_DL360_G5_A8DA802364DF.acpi
instructions=146749
accesses=71943
tolerance=1
