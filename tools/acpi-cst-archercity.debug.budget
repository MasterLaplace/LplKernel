# Window W3 of the ACPI specification (§7.4) on a recorded machine: step 8 of §3.8, the evaluation of the _CST objects
# of Intel's ArcherCity, a server, inside the ring-0 corpus test the_boot_module_machine_loads, on a debug server
# kernel (./build.sh --server). The boot runs the same function on q35's own tables first, hence skip=1.
# tools/acpi-corpus.sh module 'Server/Intel/ArcherCity/ArcherCity/356135E81941' writes the module. Checked by
# tools/instructions.sh --budget tools/acpi-cst-archercity.debug.budget kernel/lpl.kernel; a change that moves the
# count records the new one.
inside=advanced_configuration_and_power_interface_processor_idle_publish
skip=1
times=1
machine=q35
append=lpl.test=advanced_configuration_and_power_interface_corpus.the_boot_module_machine_loads
module=build/acpi-corpus/modules/Server_Intel_ArcherCity_ArcherCity_356135E81941.acpi
instructions=3279026
accesses=1388036
tolerance=1
