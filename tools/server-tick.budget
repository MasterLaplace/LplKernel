# The server's authoritative tick: what 60 calls of lpl::ecs::SystemScheduler::tick execute, without
# the loop that waits between them, on a release kernel (SMOKE_TESTS=0 ./build.sh --server) built
# with the siblings of DEPENDENCIES.lock. Checked by
# tools/instructions.sh --budget tools/server-tick.budget kernel/lpl.kernel; a pull request that
# moves the lock records the new counts.
inside=lpl::ecs::SystemScheduler::tick
times=60
instructions=1895597073
accesses=1247117679
tolerance=1
