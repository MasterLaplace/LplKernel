# Window W5 of the ACPI specification (§7.4) on a recorded machine: the publication of the routes of the PCI interrupt
# pins of the MSI MS-7E16, an AMD client, in the APIC model, every root bridge's _PRT, those of the 21 bridges below it
# and the links they name read (§3.11), inside the ring-0 corpus test the_boot_module_machine_loads, on a debug server
# kernel (./build.sh --server). The boot publishes q35's own routes first, hence skip=1. tools/acpi/corpus.sh module
# 'Desktop/MSI/MS-7/MS-7E16/B75C85853132' writes the module. Checked by tools/instructions.sh --budget
# tools/budgets/acpi-interrupt-routing-ms-7e16.debug.budget kernel/lpl.kernel; a change that moves the count records the
# new one.
inside=advanced_configuration_and_power_interface_interrupt_routing_publish
skip=1
times=1
machine=q35
append=lpl.test=advanced_configuration_and_power_interface_corpus.the_boot_module_machine_loads
module=build/acpi-corpus/modules/Desktop_MSI_MS-7_MS-7E16_B75C85853132.acpi
instructions=589857
accesses=296521
tolerance=1
