# Window W1 of the ACPI specification (§7.4) on a recorded machine, on the release path: the load of the definition
# blocks of the MSI MS-7E16, an AMD client, as a release kernel loads them (O2), inside the ring-0 corpus test
# the_boot_module_machine_loads_on_the_release_path, on a debug server kernel (./build.sh --server). The boot runs the
# same function on q35's own tables first, hence skip=1. tools/acpi-corpus.sh module
# 'Desktop/MSI/MS-7/MS-7E16/B75C85853132' writes the module. The gap to a release kernel is measured on q35's tables
# only (tools/acpi-load-q35.release-path.debug.budget): 3,826 instructions (2.66 %) fewer, all of them in mapping the
# firmware's windows, a cost that grows with the windows a machine maps. Checked by tools/instructions.sh --budget
# tools/acpi-load-ms-7e16.release-path.debug.budget kernel/lpl.kernel; a change that moves the count records the new
# one.
inside=advanced_configuration_and_power_interface_machine_language_load_directory
skip=1
times=1
machine=q35
append=lpl.test=advanced_configuration_and_power_interface_corpus.the_boot_module_machine_loads_on_the_release_path
module=build/acpi-corpus/modules/Desktop_MSI_MS-7_MS-7E16_B75C85853132.acpi
instructions=6542304
accesses=4009019
tolerance=1
