/**
 * @brief TGT1 and TGT2, then Alias (TGT1, ALI_), the first of two Aliases of ALI_.
 */
DefinitionBlock ("", "DSDT", 1, "LPLTST", "MADEUPML", 0)
{
    Name (TGT1, One)
    Name (TGT2, One)
    Alias (TGT1, ALI)
}
