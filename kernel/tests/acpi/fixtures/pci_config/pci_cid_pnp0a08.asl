/**
 * @brief Name (_CID, Package (1) {"PNP0A08"}): a compatible identifier of a PCI Express root bridge.
 */
DefinitionBlock ("", "DSDT", 1, "LPLTST", "MADEUPML", 0)
{
    Name (_CID, Package (0x01)
    {
        "PNP0A08"
    })
}
