/**
 * @brief Store (\FALT, \V2__): the statement of a loaded table that calls a method that fails.
 */
DefinitionBlock ("", "DSDT", 1, "LPLTST", "MADEUPML", 0)
{
    \V2 = \FALT __EXPECT__(6084)
}
