/**
 * @brief Return (BUSN): the body of an attach method that returns the bus number a Name holds.
 */
DefinitionBlock ("", "DSDT", 1, "LPLTST", "MADEUPML", 0)
{
    Return (BUSN) __EXPECT__(6084)
}
