/**
 * @brief Store (Zero, Local0) and Store (Zero, Local2): the start of SLOT, which a builder writes.
 */
DefinitionBlock ("", "DSDT", 1, "LPLTST", "MADEUPML", 0)
{
    Store (Zero, Local0)
    Store (Zero, Local2)
}
