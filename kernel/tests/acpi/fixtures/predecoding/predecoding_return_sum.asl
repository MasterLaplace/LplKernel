/**
 * @brief Return (Add (Local0, Local1)): the end of the MAIN of the full loop, which a builder writes.
 */
DefinitionBlock ("", "DSDT", 1, "LPLTST", "MADEUPML", 0)
{
    Return (Add (Local0, Local1))
}
