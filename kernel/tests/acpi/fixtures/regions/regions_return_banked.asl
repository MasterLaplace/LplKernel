/**
 * @brief Return (BK1_): the end of MBNK, which reads a unit of its BankField.
 */
DefinitionBlock ("", "DSDT", 1, "LPLTST", "MADEUPML", 0)
{
    Return (BK1) __EXPECT__(6084)
}
