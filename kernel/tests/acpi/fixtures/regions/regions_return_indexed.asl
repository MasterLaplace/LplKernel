/**
 * @brief Return (U2__): the end of MIDX, which reads a unit of its IndexField.
 */
DefinitionBlock ("", "DSDT", 1, "LPLTST", "MADEUPML", 0)
{
    Return (U2) __EXPECT__(6084)
}
