/**
 * @brief Name (_STA, Package (0) {}): a status that is no Integer.
 */
DefinitionBlock ("", "DSDT", 1, "LPLTST", "MADEUPML", 0)
{
    Name (_STA, Package (0x00){}) __EXPECT__(6105)
}
