/**
 * @brief _REG (2, One): the body of CALR, which calls the _REG of its scope.
 */
DefinitionBlock ("", "DSDT", 1, "LPLTST", "MADEUPML", 0)
{
    _REG (0x02, One) __EXPECT__(6084)
}
