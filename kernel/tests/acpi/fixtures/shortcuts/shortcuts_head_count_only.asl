/**
 * @brief `Name (HA__, Package (1) {Package (0) {}})`, whose inner PkgLength of 2 holds its count and nothing more.
 */
DefinitionBlock ("", "DSDT", 1, "LPLTST", "MADEUPML", 0)
{
    Name (HA, Package (0x01)
    {
        Package (0x00){}
    })
}
