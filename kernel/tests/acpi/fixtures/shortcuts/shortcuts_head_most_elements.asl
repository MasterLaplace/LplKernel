/**
 * @brief `Name (HV__, Package (1) {VarPackage (0x1000) {}})`, a VarPackage of the most elements §6.1 allows.
 */
DefinitionBlock ("", "DSDT", 1, "LPLTST", "MADEUPML", 0)
{
    Name (HV, Package (0x01)
    {
        Package (0x1000){}
    })
}
