/**
 * @brief Name (TOP_, Package (1) { One }): the top-level name after the nested packages and Devices.
 */
DefinitionBlock ("", "DSDT", 1, "LPLTST", "MADEUPML", 0)
{
    Name (TOP, Package (0x01)
    {
        One
    })
}
